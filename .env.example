# MOOSEDev environment — copy to `.env` and adjust. Every value has a working
# default. Explicit environment variables always win over `.env`.
# NEVER put real secrets in a committed file.
#
# Models, the web UI address and the trusted browser origins live in
# `moosedev.toml` (`[model]`, `[daemon]`, `[harness]`), the one file the daemon
# and the harness share — see `moosedev.toml.example`, which `moosedev init`
# drops into the project. The MOOSEDEV_HTTP_ADDR / MOOSEDEV_ALLOWED_ORIGINS /
# MOOSEDEV_LLM_* variables still work and override that file per key. What is
# left below belongs here.

# --- Core -------------------------------------------------------------------
# Where the durable store, socket, and canonical kg.nq live (relative to CWD).
# Commit <data_dir>/kg.nq; gitignore the rest (`moosedev init` sets this up).
MOOSEDEV_DATA_DIR=.moosedev

# Ontologies dir. Defaults to `ontologies/` next to the binary (release tarball)
# or the crate dir (dev), so you normally do not need to set this.
# MOOSEDEV_ONTOLOGY_DIR=./ontologies

# --- Web UI -----------------------------------------------------------------
# The bind address and the trusted origins are `[daemon]` keys in moosedev.toml
# (http_addr, allowed_origins). Disabling the UI entirely stays here.
# MOOSEDEV_NO_HTTP=1

# --- Shared backend (advanced) ---------------------------------------------
# Override the Unix socket used by --serve/--connect (default <data_dir>/moosedev.sock).
# MOOSEDEV_SOCKET=/tmp/moosedev.sock
# Make --connect require an already-running backend instead of auto-spawning one.
# MOOSEDEV_NO_AUTOSPAWN=1

# --- Optional LLM assistance ------------------------------------------------
# MOOSEDev is pure-symbolic by default. An endpoint — `endpoint` under [model]
# or [daemon.model] in moosedev.toml — is the opt-in switch that enables
# LLM-assisted features (e.g. the chat pipeline). The API key is the one setting
# that never goes in moosedev.toml: keep it in your shell environment or here,
# and out of committed files. `api_key_env` in moosedev.toml names the variable
# holding it, so a second provider can use a second variable.
# MOOSEDEV_LLM_API_KEY=lm-studio
# Assist aggressiveness 0-5 (0 = pure-symbolic; only applies when an LLM is set).
# MOOSEDEV_LLM_ASSIST_LEVEL=1

# --- Logging ----------------------------------------------------------------
# RUST_LOG=moosedev=info,rmcp=warn
